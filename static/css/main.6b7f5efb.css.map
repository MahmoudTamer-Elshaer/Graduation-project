/* style.css */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Segoe UI', sans-serif;
}

body {
  background: #fff;
}

.container {
  display: flex;
  width: 90%;
  height: 100%;
  box-shadow: 0 0 10px rgba(0,0,0,0.1);
  border-radius: 20px;
  overflow: hidden;
  margin: auto;
  margin-top: 10px;
}

.left-side {
  width: 50%;
  position: relative;
  border-radius: 25px 0 0 25px;
  overflow: hidden;
}

.left-side img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.left-side .logo {
  position: absolute;
  top: 20px;
  left: 20px;
  font-size: 20px;
  color: white;
  font-weight: bold;
  width: 215px;
}

.right-side {
  width: 50%;
  padding: 60px 80px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.right-side h2 {
  font-size: 28px;
  color: #101970;
  text-align: center;
}

.right-side .subheading {
  margin-bottom: 25px;
  font-size: 21px;
  color: #333;
  text-align: center;
}

form label {
  font-weight: 500;
  margin-top: 20px;
  margin-left: 20px;
  display: block;
}

form input[type="text"],
form input[type="email"],
.password-field input {
  width: 400px !important; /* عرض ثابت زي ما عينته */
  padding: 12px;
  margin-top: 8px;
  margin-left: 20px;
  border: 1px solid #000000;
  border-radius: 8px;
  box-sizing: border-box;
}

/* تعديل الـ password-field */
.password-field {
  position: relative;
  width: 450px; /* عرض ثابت زي الـ inputs التانية */
  margin-top: 8px;
  margin-left: 0px;
  margin-bottom: 15px;
}

.password-field input {
  width: 100%; /* يملأ الـ password-field */
  padding: 12px; /* إزالة الـ padding-right الزايد بتاع الـ eye icon */
  border: 1px solid #000000;
  border-radius: 8px;
  text-align: left;
  box-sizing: border-box;
}

/* إزالة كل حاجة متعلقة بالـ eye icon */
.password-field .eye-icon {
  display: none; /* شيل الـ eye icon كليًا */
}

/* تأكيد إن الـ input مش هيتحرك */
.password-field input:focus {
  outline: none;
  box-shadow: none;
}

.primary-btn {
  background-color: #1f3569;
  color: white;
  padding: 12px;
  border: none;
  border-radius: 8px;
  width: 400px; /* تعديل العرض ليكون نفس حقول الادخال (400px) */
  margin-top: 25px;
  margin-left: 20px;
  cursor: pointer;
  font-weight: bold;
}
.primary-btn:hover {
  background-color: #3fcdef;
}

.divider {
  margin: 25px 0;
  text-align: center;
  position: relative;
}

.divider::before,
.divider::after {
  content: "";
  position: absolute;
  width: 40%;
  height: 1px;
  background: #ccc;
  top: 50%;
}

.divider::before {
  left: 0;
}

.divider::after {
  right: 0;
}

.divider span {
  background: #fff;
  padding: 0 10px;
  color: #888;
}

.social-buttons {
  display: flex;
  gap: 15px;
  width: 436px;
  margin-left: 20px;
}

.google-btn,
.facebook-btn {
  flex: 1;
  padding: 10px;
  border: 1px solid #000000;
  border-radius: 8px;
  background: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.btn-icon {
  width: 20px;
  height: 20px;
  object-fit: contain;
}

.footer-text {
  margin-top: 20px;
  font-size: 14px;
  text-align: center;
}

.footer-text a {
  color: orange;
  text-decoration: none;
}